# Initial-cache script: --preset resolves inheritance/macros; -N never executes the project.
if(NOT DEFINED CMAKE_BUILD_TYPE OR CMAKE_BUILD_TYPE STREQUAL "")
  message(FATAL_ERROR "Preset must specify CMAKE_BUILD_TYPE (single-config Ninja required)")
endif()
if(NOT CMAKE_BUILD_TYPE MATCHES "^[A-Za-z0-9_+-]+$")
  message(FATAL_ERROR "Unsupported configuration name")
endif()
set(_config "$ENV{FOMOD_PROFILE_CONFIG}")
set(_binary "${CMAKE_BINARY_DIR}")
if(NOT _config STREQUAL "" AND NOT _config STREQUAL CMAKE_BUILD_TYPE)
  if(NOT _config MATCHES "^[A-Za-z0-9_+-]+$")
    message(FATAL_ERROR "Unsupported configuration name")
  endif()
  set(_binary "${_binary}-${_config}")
else()
  set(_config "${CMAKE_BUILD_TYPE}")
endif()
file(WRITE "$ENV{FOMOD_PROFILE_INSPECT}" "${_binary}\n${_config}\n")
