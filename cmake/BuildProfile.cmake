# The enabled target set and artifact paths have one owner: CMake.
if(NOT CMAKE_GENERATOR STREQUAL "Ninja" OR CMAKE_CONFIGURATION_TYPES)
  message(FATAL_ERROR "FOMOD build profiles currently support single-config Ninja only")
endif()
if(NOT CMAKE_BUILD_TYPE)
  message(FATAL_ERROR "FOMOD build profiles require CMAKE_BUILD_TYPE")
endif()
set(FOMOD_PLUS_PRESET "" CACHE STRING "Configure preset identity (empty for direct CMake builds)")
find_program(FOMOD_PLUS_PWSH NAMES pwsh REQUIRED)

function(_fomod_json_quote output value)
  string(REPLACE "\\" "\\\\" value "${value}")
  string(REPLACE "\"" "\\\"" value "${value}")
  string(REPLACE "\n" "\\n" value "${value}")
  string(REPLACE "\r" "\\r" value "${value}")
  set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()

set(_targets fomod_plus_installer fomod_plus_scanner)
if(FOMOD_PLUS_BUILD_PATCHFINDER)
  list(APPEND _targets fomod_plus_patch_finder)
  set(_patchfinder ON)
else()
  set(_patchfinder OFF)
endif()
set(_manifest "{")
foreach(_key source binary preset config generator patchfinder)
  if(_key STREQUAL "source")
    set(_value "${CMAKE_SOURCE_DIR}")
  elseif(_key STREQUAL "binary")
    set(_value "${CMAKE_BINARY_DIR}")
  elseif(_key STREQUAL "preset")
    set(_value "${FOMOD_PLUS_PRESET}")
  elseif(_key STREQUAL "config")
    set(_value "${CMAKE_BUILD_TYPE}")
  elseif(_key STREQUAL "generator")
    set(_value "${CMAKE_GENERATOR}")
  else()
    set(_value "${_patchfinder}")
  endif()
  _fomod_json_quote(_quoted "${_value}")
  string(APPEND _manifest "\"${_key}\":${_quoted},\n")
endforeach()
set(_translation_directory "")
if(DEFINED CACHE{MO2_PLUGIN_TARGET_DIR})
  get_filename_component(_mo2_directory "${MO2_PLUGIN_TARGET_DIR}" DIRECTORY)
  set(_translation_directory "${_mo2_directory}/translations")
endif()
_fomod_json_quote(_quoted "${_translation_directory}")
string(APPEND _manifest "\"translationDirectory\":${_quoted},\n\"artifacts\":[")
set(_separator "")
foreach(_target IN LISTS _targets)
  string(APPEND _manifest "${_separator}{\"path\":\"$<TARGET_FILE:${_target}>\",\"destination\":\"plugins/$<TARGET_FILE_NAME:${_target}>\"}")
  set(_separator ",")
  get_target_property(_translations ${_target} FOMOD_PLUS_TRANSLATIONS)
  if(_translations STREQUAL "_translations-NOTFOUND")
    # mo2_add_translations' default output (not a whole-build-tree glob).
    get_target_property(_target_binary ${_target} BINARY_DIR)
    set(_translations "${_target_binary}/${_target}_en.qm")
  endif()
  foreach(_translation IN LISTS _translations)
    get_filename_component(_name "${_translation}" NAME)
    _fomod_json_quote(_path "${_translation}")
    _fomod_json_quote(_destination "translations/${_name}")
    string(APPEND _manifest ",{\"path\":${_path},\"destination\":${_destination}}")
  endforeach()
endforeach()
string(APPEND _manifest "]}\n")
set(_manifest_path "${CMAKE_BINARY_DIR}/fomod-profile.json")
file(GENERATE OUTPUT "${_manifest_path}" CONTENT "${_manifest}")
add_custom_target(fomod_invalidate_receipt
  COMMAND "${CMAKE_COMMAND}" -E rm -f "${CMAKE_BINARY_DIR}/fomod-receipt.json"
  VERBATIM)
foreach(_target IN LISTS _targets)
  add_dependencies(${_target} fomod_invalidate_receipt)
endforeach()
add_custom_target(fomod_artifacts
  COMMAND "${FOMOD_PLUS_PWSH}" -NoProfile -File "${CMAKE_CURRENT_LIST_DIR}/PackageArtifacts.ps1"
    -Manifest "${_manifest_path}" -Record
  DEPENDS ${_targets}
  VERBATIM)
add_custom_target(package
  COMMAND "${FOMOD_PLUS_PWSH}" -NoProfile -File "${CMAKE_CURRENT_LIST_DIR}/PackageArtifacts.ps1"
    -Manifest "${_manifest_path}"
  DEPENDS fomod_artifacts
  VERBATIM)
